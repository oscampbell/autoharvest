# ==========================================
# autoharvest configuration
# ==========================================

# --- PagerDuty Configuration ---
# Your PagerDuty REST API v2 Token
# (User token from Profile -> User Settings -> Create API User Token, or Account General Access API Key)
PAGERDUTY_API_TOKEN=your_pagerduty_api_token_here

# Optional: User ID (e.g. P123ABC). If omitted, autoharvest auto-detects it via /users/me
PAGERDUTY_USER_ID=

# Optional: PagerDuty REST API Base URL (defaults to https://api.pagerduty.com)
PAGERDUTY_BASE_URL=https://api.pagerduty.com

# --- Harvest Configuration ---
# Harvest Personal Access Token from https://id.getharvest.com/developers
HARVEST_ACCESS_TOKEN=your_harvest_personal_access_token_here

# Harvest Account ID (integer string, found on https://id.getharvest.com/developers)
HARVEST_ACCOUNT_ID=your_harvest_account_id_here

# Target Harvest Project ID and Task ID to log on-call hours against.
# Recommended Task: "Active On-Call time related to non-customer impacting Pagerduty alerts"
# Run `autoharvest setup` or `autoharvest list-projects` to see all available project & task IDs!
HARVEST_PROJECT_ID=
HARVEST_TASK_ID=

# User-Agent header required by Harvest API (e.g., autoharvest (your_email@example.com))
# If left blank, autoharvest auto-populates this with your Harvest user email.
HARVEST_USER_AGENT=

# --- Sync & Time Rules ---
# Sociable hours: 08:30 to 00:00 – Weekends & 17:30 to 00:00 Weekdays (booked in 0.5h chunks, 30m window)
# Unsociable hours: All other times / overnight (booked in 1.0h chunks, 60m window)
SOCIABLE_HOURS_PER_ALERT=0.5
UNSOCIABLE_HOURS_PER_ALERT=1.0
# Book each alert as the clock hour/half-hour it falls in (an alert at 04:37 is logged
# as 04:00-05:00) instead of starting at the alert time. Override per run with
# --align-to-clock / --from-alert-time.
ALIGN_TO_CLOCK=false
HOURS_PER_ALERT=1.0

# Timezone for date grouping (e.g., UTC, Europe/London, America/New_York)
# If left blank, defaults to local system timezone
TIMEZONE=

# --- Overtime & Payroll Rates ---
# Hourly pay rates for overtime calculations (autoharvest overtime)
RATE_INACTIVE=6.0
RATE_ACTIVE=30.0
RATE_OUT_OF_HOURS=30.0
CURRENCY_SYMBOL=£

# Optional: Yearly gross salary before tax (for estimated take-home pay via `autoharvest overtime --pay`)
ANNUAL_SALARY=
